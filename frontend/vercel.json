{
  "rewrites": [
    {
      "source": "/api/send-otp",
      "destination": "/api/send-otp.js"
    },
    {
      "source": "/api/:path*",
      "destination": "https://lingkodbrgai.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://lingkodbrgai.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
